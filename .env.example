# Server
APP_ENV=development
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY_HOURS=72

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
# Base origin of the SPA. After a successful Google sign-in the backend redirects to
# <FRONTEND_URL>/auth/google-success?token=... so the front-end can capture the JWT.
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Supabase — Session Pooler, port 5432, NOT the 6543 Transaction
# pooler: GORM's driver uses prepared statements, which the Transaction pooler
# doesn't support reliably). All relational data AND message history live
# here — see internal/db/messages.go.
POSTGRES_HOST=your-project-ref.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=postgres
POSTGRES_SSLMODE=require

# Supabase Storage — S3-compatible API, shared by avatars and chat
# attachments (same project-scoped access key, different buckets). Get
# credentials from Supabase Dashboard > Project Settings > Storage >
# S3 Connection (a separate key pair from the anon/service_role API keys).
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your_supabase_storage_region
SUPABASE_S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
# Public bucket — profile/group photos served via public URL.
SUPABASE_S3_BUCKET=avatars
# Private bucket — chat attachments, read only via short-lived presigned URLs.
SUPABASE_S3_ATTACHMENTS_BUCKET=chat-attachments
